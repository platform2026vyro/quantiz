# Copia questo file in .env e inserisci i valori reali (mai committare .env)
PORT=3000

# --- Supabase (ricevi da: supabase.com/dashboard → PROJECT SETTINGS → Database) ---
# Connection string completa: postgresql://postgres:<PASSWORD>@db.<REF>.supabase.co:5432/postgres
SUPABASE_DB_URL=
# Project Settings → API → Project URL
SUPABASE_URL=
# Project Settings → API → service_role key (necessaria per REST API da server)
SUPABASE_SERVICE_KEY=
# ACCOUNT → Access Tokens → colla sbp_... (per la CLI, facoltativa se usi SUPABASE_DB_URL)
SUPABASE_ACCESS_TOKEN=
